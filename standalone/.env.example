# Chép thành standalone/.env để chạy ở máy (không commit .env)
DATABASE_URL=postgresql://postgres.<mã dự án>:<mật khẩu>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<mã dự án>.supabase.co
SUPABASE_ANON_KEY=<khóa anon public>
ADMIN_EMAILS=email-cua-ban@gmail.com

# Khóa mã hóa mật khẩu trang lịch admin lưu trên giao diện (chuỗi ngẫu nhiên dài, giữ cố định; đổi thì phải nhập lại mật khẩu)
# tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DKCT_SECRET_KEY=

# Tải lịch cắt điện từ trang Công ty (máy chủ phải vào được mạng nội bộ). Admin đặt được ở Danh mục → Tải lịch tự động;
# các giá trị dưới đây là mặc định khi admin chưa đặt
# OUTAGE_SOURCE_USER=
# OUTAGE_SOURCE_PASSWORD=
# Tự tải theo giờ hẹn (giờ Việt Nam), bỏ trống = tắt; số ngày tới cần tải (mặc định 14)
# OUTAGE_AUTO_FETCH=07:00,15:00
# OUTAGE_AUTO_DAYS=14
