{
  "name": "dkct-module",
  "version": "0.1.0",
  "private": true,
  "description": "Module Đăng ký công tác (ĐKCT) gắn vào ChatLan: lịch cắt điện, giấy ĐKCT có cấu trúc, xuất DOCX theo mẫu",
  "main": "server/index.js",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=server/** --test-coverage-include=client/lib/** \"tests/**/*.test.js\"",
    "test:pg": "node --env-file=tests/pg.env --test \"tests/**/*.test.js\"",
    "test:mysql": "node --env-file=tests/mysql.env --env-file-if-exists=tests/mysql.local.env --test --test-concurrency=4 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "docxtemplater": "^3.60.0",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pizzip": "^3.1.7",
    "web-push": "^3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "docx-preview": ">=0.3.0",
    "lucide-react": ">=0.400.0",
    "pdfjs-dist": "^5.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "mysql2": "^3.24.5"
  }
}
